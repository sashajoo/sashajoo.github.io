<header>
  <!-- Nav Bar -->
  <nav id="navbar" class="navbar navbar-light navbar-expand-xl {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}" role="navigation">
    <div class="container">
      {% if page.permalink != '/' %}
        <a class="navbar-brand title font-weight-lighter" href="{{ site.baseurl }}/">
          {% if site.title == 'blank' %}
            {% if site.first_name %}
              <span class="font-weight-bold">
                {{- site.first_name -}}
              </span>
            {% endif %}
            {% if site.middle_name %}
              {{- site.middle_name -}}
            {% endif %}
            {% if site.last_name %}
              {{- site.last_name -}}
            {% endif %}
          {% else %}
            {{- site.title -}}
          {% endif %}
        </a>
      {% elsif site.enable_navbar_social %}
        <!-- Social Icons -->
        <div class="navbar-brand social">{% social_links %}</div>
      {% endif %}
      <!-- Navbar Toggle -->
      <button
        class="navbar-toggler collapsed ml-auto"
        type="button"
        data-toggle="collapse"
        data-target="#navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="sr-only">Toggle navigation</span>
        <span class="icon-bar top-bar"></span>
        <span class="icon-bar middle-bar"></span>
        <span class="icon-bar bottom-bar"></span>
      </button>

      <div class="collapse navbar-collapse text-right" id="navbarNav">
        <ul class="navbar-nav ml-auto flex-nowrap">
          {% for page in site.pages %}
            {% if page.permalink == '/' %} {% assign about_title = page.title %} {% endif %}
          {% endfor %}

          <!-- About -->
          <li class="nav-item {% if page.permalink == '/' %}active{% endif %}">
            <a class="nav-link" href="{{ '/' | relative_url }}">
              {{- about_title }}
              {% if page.permalink == '/' %}
                <span class="sr-only">(current)</span>
              {% endif %}
            </a>
          </li>

          <!-- Sections of the about page, so the nav tracks what is on it -->
          {% for s in site.data.nav_sections %}
            <li class="nav-item nav-section">
              <a class="nav-link" href="{{ '/' | relative_url }}#{{ s.anchor }}" data-section="{{ s.anchor }}">{{ s.title }}</a>
            </li>
          {% endfor %}

          <!-- Everything above scrolls the About page; everything below is a
               page of its own. The rule is what tells the two apart. -->
          {% if site.data.nav_sections.size > 0 %}
            <li class="nav-item nav-divider" aria-hidden="true"></li>
          {% endif %}

          <!-- Other pages -->
          {% assign sorted_pages = site.pages | sort: 'nav_order' %}
          {% for p in sorted_pages %}
            {% if p.nav and p.autogen == null %}
              {% if p.dropdown %}
                <!-- A dropdown page shows its children as plain links. With two
                     children a menu only hid them behind an extra click. The
                     label shows only in the phone menu, where it heads the group. -->
                <li class="nav-item nav-group-label" aria-hidden="true">{{ p.title }}</li>
                {% for child in p.children %}
                  {% unless child.title == 'divider' %}
                    <li class="nav-item nav-child {% if page.title == child.title %}active{% endif %}">
                      <a
                        class="nav-link"
                        href="{% if child.permalink contains '://' %}{{ child.permalink }}{% else %}{{ child.permalink | relative_url }}{% endif %}"
                      >
                        {{- child.nav_title | default: child.title -}}
                        {% if page.title == child.title %}
                          <span class="sr-only">(current)</span>
                        {% endif %}
                      </a>
                    </li>
                  {% endunless %}
                {% endfor %}
              {% else %}
                {% assign parent_link = p.permalink | remove: 'index.html' %}
                <li class="nav-item nav-page {% if page.url contains parent_link %}active{% endif %}">
                  {%- if p.permalink contains '://' -%}
                    {%- assign url = p.permalink -%}
                  {%- elsif p.permalink contains '/blog/' -%}
                    {%- assign url = '/blog/' -%}
                  {%- else -%}
                    {%- assign url = p.url -%}
                  {%- endif %}
                  <a class="nav-link" href="{{ url | relative_url }}">
                    {{- p.title }}
                    {% if page.url contains p.url %}
                      <span class="sr-only">(current)</span>
                    {% endif %}
                  </a>
                </li>
              {% endif %}
            {% endif %}
          {% endfor %}
          {% if site.search_enabled %}
            <!-- Search -->
            <li class="nav-item">
              <button id="search-toggle" title="Search" onclick="openSearchModal()">
                <span class="nav-link"><span class="search-hint">ctrl k</span><span class="search-word">Search</span> <i class="fa-solid fa-magnifying-glass"></i></span>
              </button>
            </li>
          {% endif %}
          {% if site.enable_darkmode %}
            <!-- Toogle theme mode -->
            <li class="toggle-container">
              <button id="light-toggle" title="Change theme">
                <i class="fa-half-sun-moon" id="light-toggle-system"></i>
                <i class="fa-solid fa-moon" id="light-toggle-dark"></i>
                <i class="fa-solid fa-sun" id="light-toggle-light"></i>
              </button>
            </li>
          {% endif %}
        </ul>
      </div>
    </div>
  </nav>
  <script>
    // On the About page the navbar shows where you are: the section whose
    // heading was passed last is marked, and About is marked only above the
    // first section. Tapping a link in the phone menu also closes the menu.
    (function () {
      var nav = document.getElementById('navbar');
      if (!nav) return;
      nav.querySelectorAll('.navbar-collapse a.nav-link').forEach(function (a) {
        a.addEventListener('click', function () {
          var menu = document.getElementById('navbarNav');
          if (menu && menu.classList.contains('show') && window.jQuery) window.jQuery(menu).collapse('hide');
        });
      });
      // The header is parsed before the page body, so wait for the headings.
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', spy);
      } else {
        spy();
      }
    })();

    function spy() {
      var nav = document.getElementById('navbar');
      var links = nav.querySelectorAll('a[data-section]');
      if (!links.length || location.pathname !== '{{ '/' | relative_url }}') return;
      var about = nav.querySelector('.nav-item.active');
      var heads = [];
      links.forEach(function (a) {
        var h = document.getElementById(a.dataset.section);
        if (h) heads.push({ h: h, li: a.parentNode });
      });
      if (!heads.length) return;
      var ticking = false;
      function update() {
        ticking = false;
        var line = nav.getBoundingClientRect().bottom + 90;
        var current = null;
        heads.forEach(function (x) {
          if (x.h.getBoundingClientRect().top <= line) current = x;
        });
        // At the very bottom the last section may never reach the line.
        if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4) current = heads[heads.length - 1];
        heads.forEach(function (x) { x.li.classList.toggle('active', x === current); });
        if (about) about.classList.toggle('active', current === null);
      }
      window.addEventListener('scroll', function () {
        if (!ticking) { ticking = true; requestAnimationFrame(update); }
      }, { passive: true });
      window.addEventListener('resize', update);
      update();
    }
  </script>
  {% if site.enable_progressbar %}
    <!-- Scrolling Progress Bar -->
    <progress id="progress" value="0">
      <div class="progress-container">
        <span class="progress-bar"></span>
      </div>
    </progress>
  {% endif %}
</header>
