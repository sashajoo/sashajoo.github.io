---
layout: default
---
<div class="post">
  <header class="post-header">
    <div class="masthead">
      <div class="masthead-name">
        <h1 class="post-title">
          {% if site.title == 'blank' %}
            <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
            {{ site.last_name }}
          {% else %}
            {{ site.title }}
          {% endif %}
        </h1>
        <p class="desc">{{ page.subtitle }}</p>
        {% include identity.liquid %}
      </div>
    </div>
  </header>

  <article class="offprint">
    {% if page.profile %}
          <div class="profile float-{% if page.profile.align == 'left' %}left{% else %}right{% endif %}">
          {% if page.profile.image %}
            {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
            {% if page.profile.image_circular %}
              {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
            {% else %}
              {% assign profile_image_class = 'img-fluid z-depth-1
        rounded' %}
            {% endif %}
            {% capture sizes %}(min-width: {{ site.max_width }}) {{ site.max_width | minus: 30 | times: 0.3}}px, (min-width: 576px)
        30vw, 95vw"{% endcapture %}
            {%
              include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=page.profile.image
              cache_bust=true
            %}
          {% endif %}
          {% if page.profile.more_info %}
            <div class="more-info">{{ page.profile.more_info }}</div>
          {% endif %}
        </div>
    {% endif %}

    <div class="clearfix">{{ content }}</div>

    <!-- US clinical experience -->
    {% if site.data.clinical and site.data.clinical.size > 0 %}
      <h2 id="clinical">US Clinical Experience</h2>
      {% include clinical.liquid %}
    {% endif %}

    <!-- Selected papers. Anchored as "research" because the navbar calls it
         Research, to keep it apart from the standalone All Publications page. -->
    {% if page.selected_papers %}
      <h2 id="research">Selected Publications</h2>
      {% include selected_papers.liquid %}
      <div class="allpubs">
        <a href="{{ '/publications/' | relative_url }}">All publications &rarr;</a>
      </div>
    {% endif %}

    <!-- Presentations -->
    {% if site.data.presentations and site.data.presentations.size > 0 %}
      <h2 id="presentations">Selected Presentations</h2>
      {% include presentations.liquid %}
    {% endif %}

    <!-- Awards -->
    {% if site.data.awards and site.data.awards.size > 0 %}
      <h2 id="awards">Awards &amp; Honors</h2>
      {% include awards.liquid %}
    {% endif %}

    <!-- Teaching and service -->
    {% if site.data.service and site.data.service.size > 0 %}
      <h2 id="service">Teaching &amp; Service</h2>
      {% include service.liquid %}
    {% endif %}
    {% include service_photos.liquid %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
